          <p textAlign="left" lineSpacing="multiple:1.2" defaultTabSize="72"><strong><span color="rgba(90, 107, 125, 1)" fontSize="15.0" fontFamily="Heiti SC" italic="false" strikethrough="false" underline="false">非侵入式 · fMRI</span></strong></p>
        </content>
      </shape>
      <shape width="316.8" height="40.32" topLeftX="70.56" topLeftY="180" type="text" id="bRs">
        <content verticalAlign="top" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left">
          <p textAlign="left" lineSpacing="multiple:1.2" defaultTabSize="72"><strong><span color="rgba(15, 58, 87, 1)" fontSize="23" fontFamily="Heiti SC" italic="false" strikethrough="false" underline="false">脑信号 → 语义表征 → 语言</span></strong></p>
        </content>
      </shape>
      <shape width="316.8" height="72" topLeftX="70.56" topLeftY="227.51999999999998" type="text" id="bMa">
        <content verticalAlign="top" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left">
          <p textAlign="left" lineSpacing="fixed:18.00" defaultTabSize="72"><span color="rgba(22, 34, 46, 1)" fontSize="12.5" fontFamily="Heiti SC" bold="false" italic="false" strikethrough="false" underline="false">被试连续听自然叙事故事；编码模型把语言放在高维语义空间里，解码器再反推语义并生成候选词序列。</span></p>
        </content>
      </shape>
      <shape width="367.2" height="146.88" topLeftX="44.640000000000015" topLeftY="321.12" presetHandlers="9.360662" type="round-rect" id="bMr">
