        <content verticalAlign="top" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left">
          <p textAlign="left" lineSpacing="fixed:20.50" defaultTabSize="72"><strong><span color="rgba(22, 34, 46, 1)" fontSize="15.5" fontFamily="Heiti SC" italic="false" strikethrough="false" underline="false">闭环同时解决了旧问题、制造了新问题</span></strong></p>
        </content>
      </shape>
      <shape width="166.1940157480315" height="1.0080314960629921" topLeftX="508.068031496063" topLeftY="270.72" presetHandlers="0.5039956" type="round-rect" id="bFs">
