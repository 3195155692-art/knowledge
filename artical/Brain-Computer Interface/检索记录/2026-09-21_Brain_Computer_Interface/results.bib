}

@article{Zhang2024brain,
  title = {A brain-to-text framework for decoding natural tonal sentences.},
  author = {Daohan Zhang and Zhenjie Wang and Youkun Qian and Zehao Zhao and Yan Liu and Xiaotao Hao and Wanxin Li and Shuo Lu and Honglin Zhu and Luyao Chen and Kunyu Xu and Yuanning Li and Junfeng Lu},
