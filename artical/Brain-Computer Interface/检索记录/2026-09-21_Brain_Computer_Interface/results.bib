  pages = {4658-4673.e17},
  doi = {10.1016/j.cell.2025.06.015},
  url = {https://pubmed.ncbi.nlm.nih.gov/40816265/},
  abstract = {Speech brain-computer interfaces (BCIs) show promise in restoring communication to people with paralysis but have also prompted discussions regarding their potential to decode private inner speech. Separately, inner speech may be a way to bypass the current approach of requiring speech BCI users to physically attempt speech, which is fatiguing and can slow communication. Using multi-unit recordings from four participants, we found that inner speech is robustly represented in the motor cortex and that imagined sentences can be decoded in real time. The representation of inner speech was highly…}
}

